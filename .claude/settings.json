{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -f \"$r/scripts/stop-check.sh\" ] || r=\"$CLAUDE_PROJECT_DIR\"; exec bash \"$r/scripts/stop-check.sh\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
